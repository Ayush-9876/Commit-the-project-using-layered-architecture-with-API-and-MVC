@model IEnumerable<profile.Profilemodel>

@{
    ViewData["Title"] = "Register Table";
}

<h2>Register Records</h2>

Login user: @ViewBag.Username
Login Role: @ViewBag.Role

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Created</th>
            <th>Gender</th>
            <th>Gmail</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Created.ToString("dd-MM-yyyy")</td>
                <td>@item.Gender</td>
                <td>@item.Email</td>
            </tr>
        }
    </tbody>
</table>
