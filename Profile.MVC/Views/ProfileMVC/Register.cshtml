@model Profile.Shared.Register
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Register";
}

<h2>Register</h2>

<form asp-action="Create" asp-controller="ProfileMVC" method="post">

    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>

    <br />

    <div>
        <label asp-for="Created"></label>
        <input asp-for="Created" type="datetime-local" />
        <span asp-validation-for="Created"></span>
    </div>

    <br />

    <div>
        <label asp-for="Gender"></label>

        <select asp-for="Gender">
            <option value="">-- Select Gender --</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
            <option value="Other">Other</option>
        </select>

        <span asp-validation-for="Gender"></span>
    </div>

    <br />

    <div>
        <label asp-for="Gmail">Email</label>
        <input asp-for="Gmail" type="email" />
        <span asp-validation-for="Gmail"></span>
    </div>

    <br />

    <div>
        <label asp-for="password">Password</label>
        <input asp-for="password" type="password" />
        <span asp-validation-for="password"></span>
    </div>

    <br />

    <div>
        <label asp-for="role">Role</label>

        <select asp-for="role">
            <option value="">-- Select Role --</option>
            <option value="User">Manager</option>
            <option value="Admin">Admin</option>
        </select>

        <span asp-validation-for="role"></span>
    </div>

    <br />

    <button type="submit">Register</button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}